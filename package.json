    "report:protection": "vite-node scripts/report-protection.ts",
    "report:m1c": "vite-node scripts/report-m1c.ts",
    "report:m1d": "vite-node scripts/report-m1d.ts",
    "report:m2": "vite-node scripts/report-marco2.ts",
    "benchmark:m2": "node scripts/benchmark-marco2.mjs",
    "benchmark:m2:browser": "node scripts/benchmark-marco2-browser.mjs",
    "report:m21": "vite-node scripts/report-marco21.ts",
    "benchmark:m21": "node scripts/benchmark-marco21.mjs",
    "benchmark:m21:browser": "node scripts/benchmark-marco21-browser.mjs",
